# Copy to .env (repo root). Values shown are the defaults.

# SQL Server, as reached by the simulator
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASS=Password123!
DB_NAME=sim_db

# Kafka / Kafka Connect / Flink, as reached by the simulator
KAFKA_BROKERS=localhost:9092
DEBEZIUM_URL=http://localhost:8083
FLINK_URL=http://localhost:8081

# Docker Engine API (container stats, Debezium restart, Flink job submission).
# Defaults to /var/run/docker.sock, or \\.\pipe\docker_engine on Windows.
# DOCKER_SOCKET=

# Hostnames used *inside* the Docker network (written into connector / Flink configs)
CONNECTOR_DB_HOST=sqlserver
CONNECTOR_KAFKA_BOOTSTRAP=kafka:29092

# Load generator sizing
WRITER_THREADS=8
WRITER_CONCURRENCY=50
CONSUMER_THREADS=4
